---
import { I18N, DEFAULT_LANG, SITE, KOMOOT } from '../data/content.js';
const t = I18N[DEFAULT_LANG];

// One card per Komoot collection. Until Komoot answers (or if it doesn't) a card is a
// plain link to its collection with a club photo; then it previews the first ride.
const cards = KOMOOT.map((c, i) => ({ ...c, month: t.months.indexOf(c.label), photo: `/assets/tours/tour-${(i % 6) + 1}.jpg` }));
// Texts the script writes into the cards and the dialog, in every language.
const strings = Object.fromEntries(Object.entries(I18N).map(([lang, d]) => [lang, { komoot: d.komoot, months: d.months }]));
---

<section id="touren" data-chat-area="komoot" class="section white bordered reveal season" aria-label="Touren / Saison">
  <div class="container">
    <div class="season-head">
      <div>
        <div class="kicker">
          <span class="swatch"><span style="background:#1f7a43"></span><span style="background:#fff"></span><span style="background:#c0202a"></span></span>
          <span data-i18n="seasonKicker">{t.seasonKicker}</span>
        </div>
        <h2 data-i18n="seasonTitle">{t.seasonTitle}</h2>
        <p class="lead" data-i18n="seasonBody">{t.seasonBody}</p>
        {SITE.brochure && (
          <div class="season-doc" data-chat-item="site" data-chat-key="brochure">
            <a class="btn btn-green" href={SITE.brochure} target="_blank" rel="noopener" data-i18n="member.programmView">{t.member.programmView}</a>
            <a class="btn btn-ghost-dark" href={SITE.brochure} download data-i18n="member.download">{t.member.download}</a>
          </div>
        )}
      </div>
      <div class="season-arrows" aria-hidden="true">
        <button type="button" class="season-arrow" data-dir="-1" aria-label="Vorherige Touren">‹</button>
        <button type="button" class="season-arrow" data-dir="1" aria-label="Weitere Touren">›</button>
      </div>
    </div>

    <div class="tour-track" role="group" tabindex="0" aria-label="Touren der Saison">
      {cards.map((card) => (
        <a
          class="tour-card komoot-card"
          href={card.url}
          target="_blank"
          rel="noopener"
          data-komoot={card.url}
          data-note={card.note}
          data-chat-item="komoot"
          data-chat-key={card.label}
        >
          <div class="tour-photo">
            <img src={card.photo} alt="" width="640" height="400" loading="lazy" decoding="async" />
            <span class="tour-badge" hidden><span class="d"></span><span class="m"></span></span>
          </div>
          <div class="tour-meta">
            <h3 class="tour-title">
              {card.month >= 0 ? <span data-i18n={`months.${card.month}`}>{card.label}</span> : <span>{card.label}</span>}
            </h3>
            <p class="komoot-sub">{card.note}</p>
            <span class="tour-more"><span class="komoot-count"><span data-i18n="komoot.open">{t.komoot.open}</span></span> <span class="arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>
    <p class="komoot-hint" data-i18n="komoot.hint">{t.komoot.hint}</p>
  </div>

  <!-- All rides of one collection (filled on click, zooms in) -->
  <dialog class="tour-modal komoot-modal" aria-labelledby="km-title">
    <button class="tm-close" type="button" aria-label="Schliessen">×</button>
    <div class="modal-body">
      <h3 id="km-title" class="tm-title"></h3>
      <p class="tm-desc"></p>
      <ol class="ride-list"></ol>
      <div class="tm-actions">
        <a class="btn btn-green km-open" target="_blank" rel="noopener"><span data-i18n="komoot.open">{t.komoot.open}</span> <span class="arrow" style="font-size:16px">→</span></a>
      </div>
    </div>
  </dialog>
  <script type="application/json" id="komoot-i18n" set:html={JSON.stringify(strings)} />
</section>

<script>
  import { komootCollections, el, translated, monthLabel, facts } from '../scripts/komoot-page.js';

  const root = document.querySelector('#touren');
  const track = root?.querySelector('.tour-track');
  const dlg = root?.querySelector('.komoot-modal');

  if (root && track && dlg) {
    // ── carousel arrows ───────────────────────────────────
    const step = () => {
      const card = track.querySelector('.tour-card');
      return card ? card.getBoundingClientRect().width + 24 : 320;
    };
    const arrows = root.querySelectorAll<HTMLElement>('.season-arrow');
    arrows.forEach((btn) => btn.addEventListener('click', () =>
      track.scrollBy({ left: step() * Number(btn.dataset.dir), behavior: 'smooth' })));
    const updateArrows = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      arrows.forEach((b) => {
        const atEdge = Number(b.dataset.dir) < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
        b.classList.toggle('is-disabled', atEdge || max <= 0);
      });
    };
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();

    // ── one ride in the dialog: map, date, place, a link per group ──
    const link = (className: string, href: string) => {
      const a = el('a', className) as HTMLAnchorElement;
      a.href = href; a.target = '_blank'; a.rel = 'noopener';
      return a;
    };
    const rideItem = (ride) => {
      const li = el('li', 'ride');
      const first = ride.groups[0];
      const thumb = link('ride-map', first.url);
      thumb.setAttribute('aria-label', ride.place);
      if (first.map) {
        const img = el('img') as HTMLImageElement;
        img.src = first.map; img.alt = ''; img.loading = 'lazy';
        thumb.append(img);
      }
      const info = el('div', 'ride-info');
      if (ride.month) {
        const date = el('span', 'ride-date');
        date.append(el('span', 'd', `${ride.day}.`), ' ', monthLabel(ride.month));
        info.append(date);
      }
      info.append(el('span', 'ride-place', ride.place));
      const groups = el('div', 'ride-groups');
      ride.groups.forEach((g) => {
        const a = link('ride-group', g.url);
        if (g.name) a.append(el('span', 'g', g.name));
        a.append(el('span', 'f', facts(g)), el('span', 'arrow', '→'));
        groups.append(a);
      });
      info.append(groups);
      li.append(thumb, info);
      return li;
    };

    const open = (card: HTMLAnchorElement, rides) => {
      dlg.querySelector('.tm-title').replaceChildren(card.querySelector('.tour-title span').cloneNode(true));
      const note = dlg.querySelector<HTMLElement>('.tm-desc');
      note.textContent = card.dataset.note || '';
      note.hidden = !card.dataset.note;
      dlg.querySelector('.ride-list').replaceChildren(...rides.map(rideItem));
      dlg.querySelector<HTMLAnchorElement>('.km-open').href = card.href;
      dlg.showModal();
    };

    // ── a card previews the first ride of its collection ──
    const fill = (card: HTMLAnchorElement, rides) => {
      if (!rides) return; // Komoot not reachable: the card stays a link to the collection
      const sub = card.querySelector('.komoot-sub');
      const count = card.querySelector('.komoot-count');
      if (!rides.length) {
        if (!card.dataset.note) sub.replaceChildren(translated('span', '', 'komoot.soon'));
        return;
      }
      const first = rides[0];
      const map = first.groups[0].map;
      if (map) {
        const img = card.querySelector('img');
        img.src = map; img.alt = first.place;
        img.classList.add('is-map');
      }
      if (first.month) {
        const badge = card.querySelector<HTMLElement>('.tour-badge');
        badge.querySelector('.d').textContent = String(first.day);
        badge.querySelector('.m').replaceWith(monthLabel(first.month));
        badge.hidden = false;
        sub.replaceChildren(el('span', 'komoot-first', first.place));
      }
      count.replaceChildren(`${rides.length} `, translated('span', '', rides.length === 1 ? 'komoot.ride' : 'komoot.rides'));
      card.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return; // opening in a new tab still goes to Komoot
        e.preventDefault();
        open(card, rides);
      });
    };
    komootCollections().then((all) => {
      root.querySelectorAll<HTMLAnchorElement>('.komoot-card').forEach((card) => fill(card, all[card.dataset.komoot]));
    });

    dlg.querySelector('.tm-close').addEventListener('click', () => dlg.close());
    // click on the backdrop (outside the dialog box) closes
    dlg.addEventListener('click', (e) => {
      const r = dlg.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dlg.close();
    });
  }
</script>
