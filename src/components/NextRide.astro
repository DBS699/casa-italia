---
import { I18N, DEFAULT_LANG } from '../data/content.js';
const t = I18N[DEFAULT_LANG];
---

<!-- Filled from the club's Komoot collections; stays hidden when there is no dated ride. -->
<section id="naechste" class="section paper bordered reveal next-ride" aria-label="Nächste Ausfahrt" hidden>
  <div class="container">
    <div class="kicker">
      <span class="swatch"><span style="background:#1f7a43"></span><span style="background:#f6f2e9"></span><span style="background:#c0202a"></span></span>
      <span data-i18n="next.kicker">{t.next.kicker}</span>
    </div>
    <div class="nr-card">
      <a class="nr-photo" target="_blank" rel="noopener">
        <img class="nr-img" alt="" width="640" height="400" decoding="async" />
        <span class="tour-badge"><span class="d nr-day"></span><span class="m nr-month"></span></span>
      </a>
      <div class="nr-info">
        <h2 class="nr-title"></h2>
        <div class="nr-facts"></div>
        <div class="nr-actions">
          <a class="btn btn-green nr-route" target="_blank" rel="noopener"><span data-i18n="komoot.route">{t.komoot.route}</span> <span class="arrow" style="font-size:16px">→</span></a>
          <a class="btn btn-ghost-dark nr-cta" href="#touren"><span data-i18n="next.cta">{t.next.cta}</span> <span class="arrow" style="font-size:16px">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { nextRide } from '../scripts/komoot.js';
  import { komootCollections, el, translated, monthLabel, facts } from '../scripts/komoot-page.js';

  const root = document.querySelector<HTMLElement>('#naechste');
  komootCollections().then((all) => {
    const ride = nextRide(all);
    if (!root || !ride) return;
    const first = ride.groups[0];
    const img = root.querySelector<HTMLImageElement>('.nr-img');
    if (first.map) img.src = first.map;
    img.alt = ride.place;
    root.querySelector<HTMLAnchorElement>('.nr-photo').href = first.url;
    root.querySelector('.nr-day').textContent = String(ride.day);
    root.querySelector('.nr-month').replaceWith(monthLabel(ride.month));
    root.querySelector('.nr-title').textContent = ride.place;
    root.querySelector('.nr-facts').replaceChildren(...ride.groups.map((g) => {
      const fact = el('a', 'nr-fact') as HTMLAnchorElement;
      fact.href = g.url; fact.target = '_blank'; fact.rel = 'noopener';
      fact.append(g.name ? el('span', 'k', g.name) : translated('span', 'k', 'next.distance'), el('span', 'v', facts(g)));
      return fact;
    }));
    root.querySelector<HTMLAnchorElement>('.nr-route').href = first.url;
    root.hidden = false;
  });
</script>
