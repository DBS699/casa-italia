---
import { I18N, DEFAULT_LANG, NEWS } from '../data/content.js';
const t = I18N[DEFAULT_LANG];

// Meldungen from news.json, newest first. The three newest show right away, older
// ones behind a button. Without any Meldung the section and its tab are left out.
const SHOWN = 3;
const day = (iso) => {
  const [y, m, d] = String(iso).split('-');
  return d && m && y ? `${Number(d)}.${Number(m)}.${y}` : '';
};
---

{NEWS.length > 0 && (
  <section id="aktuell" data-chat-area="news" class="section paper bordered reveal news" aria-label="Aktuell">
    <div class="container">
      <div class="kicker">
        <span class="swatch"><span style="background:#1f7a43"></span><span style="background:#fff"></span><span style="background:#c0202a"></span></span>
        <span data-i18n="newsKicker">{t.newsKicker}</span>
      </div>
      <h2 data-i18n="newsTitle">{t.newsTitle}</h2>
      <div class="news-grid">
        {NEWS.map((n, i) => (
          <article class:list={['news-card', { 'has-image': n.image }]} data-chat-item="news" data-chat-key={n.title} hidden={i >= SHOWN}>
            {n.image ? (
              <div class="news-photo"><img src={n.image} alt="" width="640" height="400" loading="lazy" decoding="async" /></div>
            ) : (
              <span class="top-bar"><span class="g"></span><span class="w"></span><span class="r"></span></span>
            )}
            <div class="news-body">
              <time class="news-date" datetime={n.date}>{day(n.date)}</time>
              <h3>{n.title}</h3>
              {n.text && <p>{n.text}</p>}
              {n.link && (
                <a class="cta" href={n.link} target="_blank" rel="noopener"><span data-i18n="newsMore">{t.newsMore}</span> <span class="arrow">→</span></a>
              )}
            </div>
          </article>
        ))}
      </div>
      {NEWS.length > SHOWN && (
        <button type="button" class="btn btn-ghost-dark news-older" data-i18n="newsOlder">{t.newsOlder}</button>
      )}
    </div>
  </section>
)}

<script>
  const older = document.querySelector<HTMLButtonElement>('#aktuell .news-older');
  older?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('#aktuell .news-card[hidden]').forEach((card) => { card.hidden = false; });
    older.remove();
  });
</script>
