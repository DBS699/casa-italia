---
// Chat admin: edit the tours by writing what should change. Standalone page (not
// Base.astro); all logic that matters lives in api/chat.js, this is only the UI.
import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Touren-Chat — Velo-Club Casa d'Italia</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Libre+Caslon+Display&family=Saira+Condensed:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="chat-page">
    <header class="chat-head">
      <a href="/" class="chat-brand">
        <img src="/assets/logo.png" alt="" width="36" height="36" />
        <span>Touren-Chat</span>
      </a>
      <button type="button" class="chat-link" id="logout" hidden>Abmelden</button>
    </header>

    <main class="chat-main">
      <p class="chat-note" id="loading">Einen Moment …</p>

      <section class="chat-note" id="setup" hidden>
        <h1>Der Chat ist noch nicht eingerichtet.</h1>
        <p>Es fehlen noch die Zugangsdaten bei Vercel. Touren lassen sich bis dahin im <a href="/admin">CMS</a> ändern.</p>
      </section>

      <form class="chat-login" id="login" hidden>
        <h1>Touren ändern, einfach per Nachricht.</h1>
        <label for="password">Passwort</label>
        <input id="password" type="password" autocomplete="current-password" required />
        <p class="chat-error" id="login-error" role="alert" hidden></p>
        <button type="submit" class="chat-primary">Anmelden</button>
      </form>

      <section class="chat-room" id="room" hidden>
        <div class="chat-log" id="log" aria-live="polite">
          <div class="chat-welcome" id="welcome">
            <h1>Was möchtest du ändern?</h1>
            <p>Schreib es einfach auf. Du siehst immer zuerst einen Vorschlag, online geht erst, was du bestätigst.</p>
            <div class="chat-examples">
              <button type="button">Neue Tour am 14. März: Gurnigel-Runde, 85 km, Treffpunkt 8 Uhr</button>
              <button type="button">Welche Touren sind im August eingetragen?</button>
              <button type="button">Verschiebe die Studen-Runde um eine Woche</button>
            </div>
          </div>
        </div>

        <form class="chat-composer" id="composer">
          <div class="chat-photo" id="photo-chip" hidden>
            <img id="photo-preview" alt="Angehängtes Foto" />
            <button type="button" class="chat-link" id="photo-remove">Foto entfernen</button>
          </div>
          <div class="chat-input">
            <label class="chat-attach" title="Foto anhängen">
              <input id="photo-input" type="file" accept="image/*" />
              <span aria-hidden="true">+</span>
              <span class="sr">Foto anhängen</span>
            </label>
            <textarea id="text" rows="1" placeholder="Nachricht schreiben …" aria-label="Nachricht"></textarea>
            <button type="submit" class="chat-primary" id="send">Senden</button>
          </div>
        </form>
      </section>
    </main>

    <style is:global>
      .chat-page { height: 100dvh; overflow: hidden; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); font-family: var(--body); }
      .chat-head { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid var(--line); background: var(--card-warm); }
      .chat-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-family: var(--serif); font-size: 20px; }
      .chat-brand img { border-radius: 50%; }
      .chat-main { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 720px; margin: 0 auto; min-height: 0; overflow-y: auto; }
      .chat-note a { color: var(--green); }
      .chat-main h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(26px, 6vw, 34px); line-height: 1.15; margin: 0 0 12px; }
      .chat-link { background: none; border: 0; padding: 4px; color: var(--ink-soft); font: inherit; font-size: 14px; text-decoration: underline; cursor: pointer; }
      .chat-primary { background: var(--green); color: #fff; border: 0; border-radius: 6px; padding: 11px 18px; font-family: var(--label); font-size: 15px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
      .chat-primary:hover { background: var(--green-hover); }
      .chat-primary:disabled { opacity: 0.5; cursor: default; }
      .chat-secondary { background: none; color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 10px 16px; font-family: var(--label); font-size: 15px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
      .chat-secondary:disabled { opacity: 0.5; cursor: default; }
      .chat-note { padding: 32px 16px; color: var(--ink-soft); }
      .chat-error { color: var(--red); font-size: 15px; margin: 0; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

      .chat-login { display: flex; flex-direction: column; gap: 10px; padding: 40px 16px; max-width: 420px; }
      .chat-login label { font-family: var(--label); font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-light); }
      .chat-login input { font: inherit; font-size: 16px; padding: 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--card); color: var(--ink); }

      .chat-room { flex: 1; display: flex; flex-direction: column; min-height: 0; }
      .chat-log { flex: 1; overflow-y: auto; padding: 20px 16px; display: flex; flex-direction: column; gap: 12px; }
      .chat-welcome { padding: 12px 0; color: var(--ink-soft); }
      .chat-welcome p { margin: 0 0 16px; line-height: 1.5; }
      .chat-examples { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
      .chat-examples button { text-align: left; background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 9px 12px; font: inherit; font-size: 15px; color: var(--ink); cursor: pointer; }
      .chat-examples button:hover { border-color: var(--green); }
      .chat-msg { max-width: 88%; padding: 10px 13px; border-radius: 8px; line-height: 1.45; font-size: 16px; white-space: pre-wrap; overflow-wrap: anywhere; }
      .chat-msg.user { align-self: flex-end; background: var(--green); color: #fff; }
      .chat-msg.assistant { align-self: flex-start; background: var(--card); border: 1px solid var(--line-soft); }
      .chat-msg.error { align-self: flex-start; background: var(--card); border: 1px solid var(--red); color: var(--red); }
      .chat-msg.thinking { align-self: flex-start; color: var(--ink-light); font-style: italic; }
      .chat-msg a { color: inherit; }

      .chat-card { align-self: stretch; background: var(--card); border: 1px solid var(--green); border-radius: 8px; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
      .chat-card.is-closed { border-color: var(--line); opacity: 0.65; }
      .chat-change { display: flex; flex-direction: column; gap: 6px; }
      .chat-change + .chat-change { border-top: 1px solid var(--line-soft); padding-top: 12px; }
      .chat-kind { font-family: var(--label); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green); }
      .chat-kind.delete { color: var(--red); }
      .chat-change strong { font-weight: 600; overflow-wrap: anywhere; }
      .chat-fields { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 14.5px; }
      .chat-fields .k { display: block; color: var(--ink-light); font-size: 13px; }
      .chat-fields .v { overflow-wrap: anywhere; }
      .chat-fields del { color: var(--ink-light); }
      .chat-fields ins { text-decoration: none; font-weight: 600; }
      .chat-actions { display: flex; flex-wrap: wrap; gap: 10px; }

      .chat-composer { position: sticky; bottom: 0; border-top: 1px solid var(--line); background: var(--paper); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 8px; }
      .chat-photo { display: flex; align-items: center; gap: 10px; }
      .chat-photo img { width: 56px; height: 56px; object-fit: cover; border-radius: 6px; }
      .chat-input { display: flex; align-items: flex-end; gap: 8px; }
      .chat-input textarea { flex: 1; min-width: 0; resize: none; max-height: 160px; font: inherit; font-size: 16px; line-height: 1.4; padding: 10px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--card); color: var(--ink); }
      .chat-attach { flex: none; width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 6px; background: var(--card); font-size: 24px; line-height: 1; color: var(--ink-soft); cursor: pointer; position: relative; }
      .chat-attach input { position: absolute; inset: 0; opacity: 0; cursor: pointer; font-size: 0; }
      .chat-attach:focus-within { outline: 2px solid var(--green); outline-offset: 1px; }
    </style>

    <script is:inline>
      (function () {
        const $ = (id) => document.getElementById(id);
        const log = $('log');
        const text = $('text');
        const send = $('send');

        let history = [];
        let photo = null;
        let busy = false;
        let openCard = null;

        const show = (view) => {
          ['loading', 'setup', 'login', 'room'].forEach((id) => { $(id).hidden = id !== view; });
          $('logout').hidden = view !== 'room';
        };

        async function call(action, payload) {
          const r = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action, ...payload }),
          });
          const data = await r.json().catch(() => ({}));
          if (data.loggedOut) show('login');
          if (!r.ok) throw new Error(data.error || 'Das hat gerade nicht geklappt. Bitte versuch es nochmals.');
          return data;
        }

        function el(tag, className, content) {
          const node = document.createElement(tag);
          if (className) node.className = className;
          if (content !== undefined) node.textContent = content;
          return node;
        }

        function addMessage(kind, content) {
          $('welcome').hidden = true;
          const node = el('div', `chat-msg ${kind}`, content);
          log.appendChild(node);
          log.scrollTop = log.scrollHeight;
          return node;
        }

        function setBusy(value) {
          busy = value;
          send.disabled = value;
        }

        function closeCard() {
          if (!openCard) return;
          openCard.classList.add('is-closed');
          openCard.querySelectorAll('button').forEach((b) => { b.disabled = true; });
          openCard = null;
        }

        const KIND_LABEL = { add: 'Neue Tour', update: 'Änderung', delete: 'Wird gelöscht' };

        function renderChange(change) {
          const box = el('div', 'chat-change');
          box.appendChild(el('span', `chat-kind ${change.kind}`, KIND_LABEL[change.kind]));
          box.appendChild(el('strong', '', `${change.title} · ${change.date}`));
          if (change.fields.length) {
            const list = el('ul', 'chat-fields');
            change.fields.forEach((f) => {
              const item = el('li');
              item.appendChild(el('span', 'k', f.label));
              const value = el('span', 'v');
              if (f.before) { value.appendChild(el('del', '', f.before)); value.append(' → '); }
              value.appendChild(el('ins', '', f.after || '(leer)'));
              item.appendChild(value);
              list.appendChild(item);
            });
            box.appendChild(list);
          }
          return box;
        }

        function addProposal(proposal) {
          closeCard();
          const card = el('div', 'chat-card');
          proposal.changes.forEach((c) => card.appendChild(renderChange(c)));
          const actions = el('div', 'chat-actions');
          const publish = el('button', 'chat-primary', 'Veröffentlichen');
          const discard = el('button', 'chat-secondary', 'Verwerfen');
          publish.type = 'button';
          discard.type = 'button';
          publish.addEventListener('click', () => doPublish(proposal, publish));
          discard.addEventListener('click', () => {
            closeCard();
            history.push({ role: 'assistant', text: 'Der Vorschlag wurde verworfen, nichts wurde geändert.' });
            addMessage('assistant', 'Alles klar, nichts geändert.');
          });
          actions.append(publish, discard);
          card.appendChild(actions);
          log.appendChild(card);
          log.scrollTop = log.scrollHeight;
          openCard = card;
        }

        async function run(action, payload) {
          setBusy(true);
          const thinking = addMessage('thinking', 'Einen Moment …');
          try {
            const data = await call(action, payload);
            thinking.remove();
            history.push({ role: 'assistant', text: data.reply });
            addMessage('assistant', data.reply);
            if (data.proposal) addProposal(data.proposal);
          } catch (e) {
            thinking.remove();
            addMessage('error', e.message);
          } finally {
            setBusy(false);
          }
        }

        async function doPublish(proposal, button) {
          if (busy) return;
          button.textContent = 'Wird veröffentlicht …';
          setBusy(true);
          openCard.querySelectorAll('button').forEach((b) => { b.disabled = true; });
          const needsPhoto = proposal.type === 'change' && proposal.operations.some((op) => op.useAttachment);
          try {
            const { type, operations, commit } = proposal;
            await call('publish', {
              proposal: { type, operations, commit },
              photo: needsPhoto && photo ? { base64: photo.base64 } : undefined,
            });
            closeCard();
            if (needsPhoto) clearPhoto();
            history.push({ role: 'assistant', text: 'Der Vorschlag wurde veröffentlicht.' });
            const done = addMessage('assistant', 'Veröffentlicht. In etwa einer Minute ist es auf der ');
            const link = el('a', '', 'Website');
            link.href = '/#touren';
            link.target = '_blank';
            done.append(link, ' zu sehen.');
            const undo = el('button', 'chat-secondary', 'Rückgängig machen');
            undo.type = 'button';
            undo.addEventListener('click', () => {
              if (busy) return;
              undo.remove();
              closeCard();
              run('propose-undo', {});
            });
            const row = el('div', 'chat-actions');
            row.appendChild(undo);
            log.appendChild(row);
            log.scrollTop = log.scrollHeight;
          } catch (e) {
            button.textContent = 'Veröffentlichen';
            openCard.querySelectorAll('button').forEach((b) => { b.disabled = false; });
            addMessage('error', e.message);
          } finally {
            setBusy(false);
          }
        }

        function submit() {
          const value = text.value.trim();
          if (!value || busy) return;
          closeCard();
          addMessage('user', value);
          history.push({ role: 'user', text: value });
          text.value = '';
          text.style.height = '';
          run('propose', { messages: history, hasAttachment: Boolean(photo) });
        }

        function clearPhoto() {
          if (photo) URL.revokeObjectURL(photo.url);
          photo = null;
          $('photo-input').value = '';
          $('photo-chip').hidden = true;
        }

        // Shrink in the browser: phone photos are far larger than the site needs,
        // and the upload has to stay under Vercel's request size limit.
        async function preparePhoto(file) {
          const bitmap = await createImageBitmap(file);
          const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(bitmap.width * scale);
          canvas.height = Math.round(bitmap.height * scale);
          canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          bitmap.close();
          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
          const bytes = new Uint8Array(await blob.arrayBuffer());
          let binary = '';
          for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
          return { base64: btoa(binary), url: URL.createObjectURL(blob) };
        }

        $('photo-input').addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (!file) return;
          try {
            const prepared = await preparePhoto(file);
            clearPhoto();
            photo = prepared;
            $('photo-preview').src = photo.url;
            $('photo-chip').hidden = false;
          } catch (err) {
            e.target.value = '';
            addMessage('error', 'Dieses Foto konnte ich nicht lesen. Versuch es bitte mit einem JPG oder PNG.');
          }
        });
        $('photo-remove').addEventListener('click', clearPhoto);

        $('composer').addEventListener('submit', (e) => { e.preventDefault(); submit(); });
        text.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); submit(); }
        });
        text.addEventListener('input', () => {
          text.style.height = 'auto';
          text.style.height = `${text.scrollHeight + 2}px`;
        });
        document.querySelectorAll('.chat-examples button').forEach((b) => {
          b.addEventListener('click', () => { text.value = b.textContent; text.focus(); });
        });

        $('login').addEventListener('submit', async (e) => {
          e.preventDefault();
          const error = $('login-error');
          error.hidden = true;
          try {
            await call('login', { password: $('password').value });
            $('password').value = '';
            show('room');
            text.focus();
          } catch (err) {
            error.textContent = err.message;
            error.hidden = false;
          }
        });

        $('logout').addEventListener('click', async () => {
          await call('logout', {}).catch(() => {});
          show('login');
        });

        call('status', {})
          .then((s) => show(!s.configured ? 'setup' : s.loggedIn ? 'room' : 'login'))
          .catch(() => show('setup'));
      })();
    </script>
  </body>
</html>
